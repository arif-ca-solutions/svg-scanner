{
    "name": "arif/svg-upload-security",
    "description": "Laravel middleware to inspect and sanitize SVG uploads (requires enshrined/svg-sanitize; installed automatically via Composer)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "enshrined/svg-sanitize": "^1.1.1",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "TwoBase\\SvgUploadSecurity\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TwoBase\\SvgUploadSecurity\\SvgUploadSecurityServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
